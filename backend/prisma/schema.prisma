  name             String
  platform         String? // "Cisco Packet Tracer", "Arduino Sim"…
  category         String
  iconEmoji        String?
  totalExperiments Int          @default(0)
  themeColor       String?
  sessions         LabSession[]
  createdAt        DateTime     @default(now())
}

model LabSession {
  id             String     @id @default(cuid())
  labId          String
  lab            VirtualLab @relation(fields: [labId], references: [id])
  userId         String
