model StudyRoomMember {
  roomId   String
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  joinedAt DateTime  @default(now())

  @@id([roomId, userId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────
//  Library
// ────────────────────────────────────────────────────────────────
model Book {
