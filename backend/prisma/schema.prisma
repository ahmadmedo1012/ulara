// ────────────────────────────────────────────────────────────────
//  012-design-graphics-uplift — theme preference enum
// ────────────────────────────────────────────────────────────────
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

// ────────────────────────────────────────────────────────────────
//  r178 — Institutions & memberships (أساس المؤسسات المتعددة)
// ────────────────────────────────────────────────────────────────

// المؤسسة سياق تعليمي داخل أُلارا (ليست هوية بصرية — لا شعارات ولا
// نطاقات). Phase Ω: المنصّة مستقلة متعددة المستأجرين ولا تنتمي لأي
// جامعة؛ مساحتا العرض الموسومتان (ulara-demo و ulara-demo-2)
// تحملان البيانات التجريبية وتثبتان تفرد رموز المقررات وأرقام
// التسجيل على مستوى المؤسسة لا المنصة.
model Institution {
  id        String            @id @default(cuid())
  name      String
  nameEn    String?
  slug      String            @unique
  status    InstitutionStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // ── r352 — institutional classification (all nullable: additive, the
  // legacy demo workspaces stay valid without classification) ──
  // Sector + kind come from Law 9/2026 (HE & SR) and Law 21/2023 (TVET);
  // the kind catalog is a seeded table (see LEGAL-MATRIX.md).
  sector                   InstitutionSector?
  kindId                   String?
  kind                     InstitutionType?      @relation(fields: [kindId], references: [id])
  ownership                OwnershipType?
  supervisingAuthorityId   String?
  supervisingAuthority     RegulatoryAuthority?  @relation(fields: [supervisingAuthorityId], references: [id])
  establishmentDecisionNumber String?
  establishmentDecisionDate   DateTime?
  // Legally-justified affiliation only (e.g. a separately-established
  // research center under a university). Service-level invariants: no
  // cycles, no cross-sector parents.
  parentInstitutionId      String?
  parentInstitution        Institution?           @relation("InstitutionAffiliation", fields: [parentInstitutionId], references: [id])
  affiliatedInstitutions   Institution[]          @relation("InstitutionAffiliation")

  memberships      Membership[]
  faculties        Faculty[]
  students         StudentProfile[]
  courses          Course[]
  permissionGrants UserPermission[]
  auditLogs        AuditLog[]
  posts            Post[]
  studyRooms       StudyRoom[]
  campusEvents     CampusEvent[]
  competitions     Competition[]
  researchPapers   ResearchPaper[]
  aiConversations  AiConversation[]
  aiKnowledgeChunks AiKnowledgeChunk[]

  // r352 reverse relations
  organizationalUnits    OrganizationalUnit[]
  people                 InstitutionalPerson[]
  appointments           PositionAppointment[]
  unitCapabilityGrants   UnitCapabilityGrant[]
  learnerProfiles        LearnerProfile[]
  councils               Council[]
  academicTerms          AcademicTerm[]
  programs               Program[]
  trainingPlacements     TrainingPlacement[]
  awardedCredentials     AwardedCredential[]
  externalAccreditations ExternalAccreditation[]
  operationalLicenses    OperationalLicense[]
  regulatoryInspections  RegulatoryInspection[]
  complianceFindings     ComplianceFinding[]
  internalSelfAssessments InternalSelfAssessment[]
  complianceEvidence     ComplianceEvidence[]
  facilities             Facility[]
  equipment              Equipment[]
  maintenanceWorkOrders  MaintenanceWorkOrder[]
  facilityReservations   FacilityReservation[]
  safetyIncidents        SafetyIncident[]
  researchProjects       ResearchProject[]
  researchOutputs        ResearchOutput[]
  localPositionVariants  PositionTemplate[]
  localOrgUnitTypes      OrgUnitTypeDefinition[] @relation("LocalOrgUnitTypes")

  @@index([status])
}

// عضوية المستخدم داخل مؤسسة واحدة — مصدر الدور الفعلي داخل المؤسسة.
// التفرد (userId, institutionId) يضمن صفًّا واحدًا لكل زوج، وisActive=false
// هو مقبض سحب الصلاحية (يُلغى/يُستعاد دون حذف التاريخ).
//
// ⚠ role يعيد استخدام enum المسمى Role — قيمة OWNER محظورة هنا على
// مستوى التطبيق (Zod DTOs + حرّاس الخدمة): Prisma 5.22 لا يدعم قيود
// CHECK. ملكية المنصة تُعبَّر عنها فقط بـ User.role == OWNER ولا يكون
// للمالك عضوية مؤسسة إطلاقًا.
model Membership {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  role          Role
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([institutionId, isActive])
  @@index([userId, isActive])
}

// ────────────────────────────────────────────────────────────────
//  Identity & access
// ────────────────────────────────────────────────────────────────
model User {
  id                       String          @id @default(cuid())
  email                    String          @unique
  passwordHash             String
  role                     Role
  firstName                String
  lastName                 String
  avatarColor              String? // hex like "#4F8EF7"
  avatarInitials           String? // computed Arabic 2-letter initials
  emailVerifiedAt          DateTime?
  isActive                 Boolean         @default(true)
  tokenVersion             Int             @default(0) // incremented to revoke all refresh tokens
  failedLoginCount         Int             @default(0)
  lockedUntil              DateTime?
  // Governance scope — for ADMIN/QUALITY users.
  // NULL = university-wide; set = scoped to that faculty only.
  scopeFacultyId           String?
  scopeFaculty             Faculty?        @relation("FacultyScopedAdmins", fields: [scopeFacultyId], references: [id])
  // 012-design-graphics-uplift — presentation preferences (no PII).
  // See specs/012-design-graphics-uplift/data-model.md.
  themePreference          ThemePreference @default(SYSTEM)
  themePreferenceUpdatedAt DateTime        @default(now())
  onboardingCompletedAt    DateTime?
  firedMilestones          String[]        @default([])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // r178: profiles are per-MEMBERSHIP now (a user can study in one
  // institution and teach in another) — hence plural reverse relations.
  // Legacy single-profile surfaces resolve via the membership context.
  memberships     Membership[]
  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]

  enrollments         Enrollment[]         @relation("StudentEnrollments")
  taughtOfferings     CourseOffering[]     @relation("TeacherOfferings")
  submissions         Submission[]
  grades              Grade[]              @relation("StudentGrades")
  attendanceRecords   AttendanceRecord[]
  uploadedMaterials   Material[]           @relation("MaterialUploader")
  notifications       Notification[]
  sentMessages        Message[]            @relation("MessageSender")
  receivedMessages    Message[]            @relation("MessageReceiver")
  posts               Post[]
  postComments        PostComment[]
  postReactions       PostReaction[]
  studyRoomMembers    StudyRoomMember[]
  studyRoomsOwned     StudyRoom[]          @relation("StudyRoomOwner")
  loans               Loan[]
  moocEnrollments     MoocEnrollment[]
  jobApplications     JobApplication[]
  achievements        UserAchievement[]
  skills              UserSkill[]
  certificates        Certificate[]
  labSessions         LabSession[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]
  watchEvents         WatchEvent[]         @relation("StudentWatchEvents")
  checkpointAnswers   CheckpointAnswer[]   @relation("StudentCheckpointAnswers")
  masteries           StudentMastery[]     @relation("StudentMasteries")
  researchPapers      ResearchPaper[]      @relation("StudentPapers")
  reviewedPapers      ResearchPaper[]      @relation("ProfessorReviewedPapers")
  paperAnnotations    PaperAnnotation[]
  trainingEnrollments TrainingEnrollment[]
  badges              UserBadge[]
  pointsLedger        PointsLedger[]
  // Governance
  permissionGrants    UserPermission[]     @relation("UserPermissionUser")
  permissionGrantedBy UserPermission[]     @relation("UserPermissionGranter")
  unitCapabilityGrants UnitCapabilityGrant[]
  verifiedTeachers    TeacherProfile[]     @relation("TeacherProfileVerifier")
  // Exams
  authoredQuestions   Question[]           @relation("QuestionAuthor")
  moderatedQuestions  Question[]           @relation("QuestionModerator")
  authoredExams       ExamTemplate[]       @relation("ExamAuthor")
  moderatedExams      ExamTemplate[]       @relation("ExamModerator")
  examAttempts        ExamAttempt[]
  liveSessions        LiveSession[]        @relation("LiveSessionTeacher")
  // Social
  announcements       Announcement[]
  competitionsRun     Competition[]        @relation("CompetitionOrganizer")
  competitionEntries  CompetitionEntry[]
  eventsRun           CampusEvent[]        @relation("EventOrganizer")
  eventRsvps          EventRSVP[]
  // R320 §D (P0-3/P0-4) — the forgot-password flow's single-use tokens.
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([email])
  @@index([scopeFacultyId])

  // r323 B3.1 — the invite codes this user issued / consumed.
  issuedInvites  InviteCode[] @relation("InviteCodeCreator")
  inviteUses     InviteUse[]  @relation("InviteUseUser")

  // r323 B3.6 — the pilot feedback loop the user filed.
  feedbackSent   PilotFeedback[]

  // r326 M1.1 — the client-error telemetry the user's devices sent
  // (optional userId — anonymous crash reports are accepted).
  clientErrors   ClientError[]

  // r326 M2.6 — the push devices registered by this user's installs.
  pushDevices    PushDevice[]

  // r352 — unified people domain (optional account link) + scoped
  // capability grants (r352 hardening §3.2: single capabilities, never
  // role bundles).
  institutionalPeople InstitutionalPerson[]
  learnerProfiles    LearnerProfile[]
}

model StudentProfile {
  // r178 restructure: the profile is per-MEMBERSHIP, not per-user — the
  // same user may hold student profiles in different institutions. New
  // cuid PK; the legacy userId PK is gone (userId keeps FK + index for
  // legacy single-context reads).
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId  String      @unique
  membership    Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  // Denormalized on purpose: institution-scoped uniqueness of the
  // reg-number + institution-scoped queries avoid the membership hop.
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  universityId  String
  facultyId     String
  faculty       Faculty     @relation(fields: [facultyId], references: [id])
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  year          Int         @default(1)
  gpa           Decimal     @default(0) @db.Decimal(3, 2)
  totalXp       Int         @default(0)
  level         Int         @default(1)
  // r352 — الطالب ≠ المتدرب (Law 21/2023 Art. 2): the legal learner
  // category, kept separate from course Enrollment and program context.
  learnerCategory LearnerCategory @default(STUDENT)
  // r352 hardening §5 — non-destructive bridge to the generalized
  // learner record (1:1). Set by the migration backfill for existing
  // rows; new registrations may start from either side.
  learnerProfileId String? @unique
  learnerProfile   LearnerProfile? @relation(fields: [learnerProfileId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // r352 reverse relations
  programEnrollments  ProgramEnrollment[]
  trainingPlacements  TrainingPlacement[]
  awardedCredentials  AwardedCredential[]

  // رقم التسجيل الجامعي مُتفرّد لكل مؤسسة — نفس الرقم قد يوجد في
  // مؤسسة أخرى (r178).
  @@unique([institutionId, universityId])
  @@index([userId])
  @@index([institutionId])
  @@index([facultyId])
  @@index([departmentId])
}

model TeacherProfile {
  // r178 restructure: per-membership profile with its own cuid PK (the
  // institution is reached through membership — no denormalized column
  // here; teacher queries resolve membership.institutionId).
  id                   String            @id @default(cuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId         String            @unique
  membership           Membership        @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  specialty            String
  rank                 AcademicRank      @default(LECTURER)
  departmentId         String
  department           Department        @relation("TeacherHomeDepartment", fields: [departmentId], references: [id])
  bio                  String?
  // Onboarding / suitability detection
  degreeLevel          DegreeLevel       @default(MASTERS)
  yearsExperience      Int               @default(0)
  certifications       Json? // [{ title, issuer, year }]
  publications         Json? // [{ title, venue, year, url? }]
  awards               Json? // [{ title, year, issuer? }]
  profileImageUrl      String?
  officeLocation       String? // e.g. "مبنى الكلية - مكتب 305"
  officeHours          String? // e.g. "الأحد والثلاثاء 10-12"
  websiteUrl           String?
  subjectKeywords      String[]          @default([]) // ["AI", "Machine Learning", "Statistics"]
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           User?             @relation("TeacherProfileVerifier", fields: [verifiedById], references: [id])
  // Academic leadership appointment, layered on top of teaching.
  // Nullable: a TeacherProfile without a position is just a regular professor.
  position             AcademicPosition?
  positionFacultyId    String?
  positionFaculty      Faculty?          @relation("FacultyLeadership", fields: [positionFacultyId], references: [id])
  positionDepartmentId String?
  positionDepartment   Department?       @relation("DepartmentLeadership", fields: [positionDepartmentId], references: [id])
  appointedAt          DateTime?
  termEndsAt           DateTime?
  // r352 — link to the unified people domain (DECISIONS.md: academic
  // profile stays distinct from the general employment record). The
  // legacy position columns above are preserved for existing readers;
  // new leadership history lives in PositionAppointment.
  personId             String?           @unique
  person               InstitutionalPerson? @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([userId])
  @@index([departmentId])
  @@index([verifiedById])
  @@index([positionFacultyId])
  @@index([positionDepartmentId])
}

// ────────────────────────────────────────────────────────────────
//  Academic structure
// ────────────────────────────────────────────────────────────────
model Faculty {
  id                 String             @id @default(cuid())
  // The same faculty name can exist in multiple cities (e.g. "كلية الاقتصاد"
  // in two different cities are distinct campuses). Since r178 the institution
  // carries the scoping — uniqueness is on (institutionId, name, city).
  name               String
  nameEn             String?
  iconEmoji          String?
  // City the faculty is located in. r178: no column default — the
  // institution now carries the scoping and new faculties are created
  // with an explicit city.
  city               String
  institutionId      String
  institution        Institution        @relation(fields: [institutionId], references: [id])
  createdAt          DateTime           @default(now())
  departments        Department[]
  students           StudentProfile[]
  questionCategories QuestionCategory[]
  examTemplates      ExamTemplate[]
  // Reverse relations for governance scoping (ADR — sub-project A)
  scopedAdmins       User[]             @relation("FacultyScopedAdmins")
  leadership         TeacherProfile[]   @relation("FacultyLeadership")

  // r352 — the unified organizational-unit mirror (see DECISIONS.md D3:
  // write-through sync, never two unsynchronized sources of truth).
  orgUnitId          String?            @unique
  orgUnit            OrganizationalUnit? @relation(fields: [orgUnitId], references: [id])

  @@unique([institutionId, name, city])
  @@index([city])
  @@index([institutionId])
  @@index([orgUnitId])

  // r323 B3.1
  inviteCodes InviteCode[]
}

model Department {
  id                 String             @id @default(cuid())
  name               String
  nameEn             String?
  facultyId          String
  faculty            Faculty            @relation(fields: [facultyId], references: [id])
  courses            Course[]
  students           StudentProfile[]
  teachers           TeacherProfile[]   @relation("TeacherHomeDepartment")
  createdAt          DateTime           @default(now())
  questionCategories QuestionCategory[]
  // Reverse relation for department-head appointments
  leadership         TeacherProfile[]   @relation("DepartmentLeadership")

  // r352 — the unified organizational-unit mirror (DECISIONS.md D3).
  orgUnitId          String?            @unique
  orgUnit            OrganizationalUnit? @relation(fields: [orgUnitId], references: [id])

  @@unique([facultyId, name])
  @@index([facultyId])
  @@index([orgUnitId])

  // r323 B3.1
  inviteCodes InviteCode[]
}

model Course {
  id            String             @id @default(cuid())
  code          String
  name          String
  nameEn        String?
  description   String?
  credits       Int                @default(3)
  iconEmoji     String?
  themeColor    String?
  // r178: denormalized from department.faculty.institutionId — derived
  // and validated by app code on every create/update (app-level
  // invariant) so course codes stay unique per institution.
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  departmentId  String
  department    Department         @relation(fields: [departmentId], references: [id])
  // r352 hardening §5 — additive organizational ownership: technical
  // programs define courses through their REAL org units without
  // fabricating faculties/departments. Nullable: the legacy Department
  // relation stays the required bridge for existing university rows
  // (one synchronized Course system — never a second one).
  orgUnitId     String?
  orgUnit       OrganizationalUnit? @relation(fields: [orgUnitId], references: [id])
  offerings     CourseOffering[]
  concepts      KnowledgeConcept[]
  // r352 — program curriculum links (ProgramCourse → Course).
  programLinks  ProgramCourse[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
  @@index([departmentId])
  @@index([orgUnitId])
}

model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  teacherId String
  teacher   User     @relation("TeacherOfferings", fields: [teacherId], references: [id])
  term      String // e.g. "2024-FALL"
  room      String?
  capacity  Int      @default(40)
  createdAt DateTime @default(now())

  enrollments    Enrollment[]
  schedule       ScheduleSlot[]
  materials      Material[]
  assignments    Assignment[]
  attendance     AttendanceSession[]
  grades         Grade[]
  lectures       Lecture[]
  researchPapers ResearchPaper[]
  examTemplates  ExamTemplate[]
  liveSessions   LiveSession[]

  @@unique([courseId, term, teacherId])
  @@index([teacherId])
  @@index([term])

  // r323 B3.1
  inviteCodes InviteCode[]
}

model Enrollment {
  id          String         @id @default(cuid())
  studentId   String
  student     User           @relation("StudentEnrollments", fields: [studentId], references: [id])
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  status      String         @default("active")
  progressPct Int            @default(0)
  enrolledAt  DateTime       @default(now())

  @@unique([studentId, offeringId])
  @@index([offeringId])
}

model ScheduleSlot {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Sunday … 6=Saturday (Arabic week starts Sunday)
  startTime  String // "08:00"
  endTime    String // "09:30"
  room       String?

  @@index([offeringId])
}

// ────────────────────────────────────────────────────────────────
//  Materials & uploads
// ────────────────────────────────────────────────────────────────
model Material {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  uploaderId  String
  uploader    User           @relation("MaterialUploader", fields: [uploaderId], references: [id])
  name        String
  description String?
  type        MaterialType
  sizeBytes   BigInt         @default(0)
  url         String
  views       Int            @default(0)
  downloads   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([offeringId])
  @@index([type])
  @@index([uploaderId])
}

// ────────────────────────────────────────────────────────────────
//  Assignments & submissions
// ────────────────────────────────────────────────────────────────
model Assignment {
  id          String         @id @default(cuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  title       String
  description String?
  type        AssignmentType
  dueAt       DateTime
  weight      Int            @default(10)
  maxScore    Int            @default(100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submissions Submission[]

  @@index([offeringId])
  @@index([dueAt])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
  fileUrl      String?
  textAnswer   String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Grades & attendance
// ────────────────────────────────────────────────────────────────
model Grade {
  id         String         @id @default(cuid())
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id])
  studentId  String
  student    User           @relation("StudentGrades", fields: [studentId], references: [id])
  kind       GradeKind
  score      Decimal        @db.Decimal(5, 2)
  maxScore   Int            @default(100)
  weight     Int            @default(10)
  feedback   String?
  recordedAt DateTime       @default(now())

  @@unique([offeringId, studentId, kind])
  @@index([studentId])
}

model AttendanceSession {
  id         String             @id @default(cuid())
  offeringId String
  offering   CourseOffering     @relation(fields: [offeringId], references: [id])
  date       DateTime
  topic      String?
  records    AttendanceRecord[]
  createdAt  DateTime           @default(now())

  @@unique([offeringId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   User              @relation(fields: [studentId], references: [id])
  status    AttendanceStatus
  notes     String?

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ────────────────────────────────────────────────────────────────
//  Notifications & messaging
// ────────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  icon      String?
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  // r146 (T1-c F5): the notifications list (GET /me/notifications — the
  // most-polled route) sorts by createdAt desc per user; (userId, readAt)
  // serves only the unread counter — this turns the sort into an index
  // range scan instead of a sort step.
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String
  fromUser   User      @relation("MessageSender", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("MessageReceiver", fields: [toUserId], references: [id])
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([toUserId, readAt])
  @@index([fromUserId])
}

// ────────────────────────────────────────────────────────────────
//  Social: posts, comments, study rooms
// ────────────────────────────────────────────────────────────────
model Post {
  id            String      @id @default(cuid())
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
