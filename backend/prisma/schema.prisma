  jobId      String
  job        Job                  @relation(fields: [jobId], references: [id])
  userId     String
  user       User                 @relation(fields: [userId], references: [id])
  status     JobApplicationStatus @default(APPLIED)
  matchScore Int?
  appliedAt  DateTime             @default(now())

  @@unique([jobId, userId])
  @@index([userId])
