  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

model PostReaction {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])
