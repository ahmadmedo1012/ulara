// ─── Phase: governance + exams + social ─────────────────────────
enum DegreeLevel {
  BACHELORS
  MASTERS
  PHD
}

enum Capability {
  // Research
  RESEARCH_GRADE_OWN // grade papers in offerings I teach
  RESEARCH_GRADE_ANY // grade any paper (admin override)
  RESEARCH_PUBLISH // publish to library
  // Exams
  EXAMS_AUTHOR // create exam templates + questions
  EXAMS_MODERATE // approve / reject exam templates
  EXAMS_TAKE // take exams (default for students)
  // Curriculum
  CURRICULUM_EDIT_OWN // edit lectures/chapters in my offerings
  CURRICULUM_EDIT_ANY // edit any course curriculum
  // Governance
  USERS_MANAGE // create/disable user accounts
  ROLES_ASSIGN // assign role + capabilities
  TEACHERS_VERIFY // verify teacher profiles for onboarding
  // Quality
  QUALITY_VIEW // read quality dashboards
  QUALITY_REPORT // file quality reports
  // Communications
  ANNOUNCE_PLATFORM // platform-wide announcements
  ANNOUNCE_FACULTY // faculty/department/course announcements
  COMPETITIONS_RUN // create competitions
  EVENTS_RUN // create campus events
  // r352 — institutional-core capabilities (new modules). Defaults per
  // DECISIONS.md: ADMIN gets the institutional-operations set, OWNER keeps
  // the full set, QUALITY gets NONE of these by default — in particular
  // QUALITY_INTERNAL_MANAGE is an explicit-grant-only capability so the
  // QUALITY role's read-only oversight semantics are preserved.
  ORG_STRUCTURE_MANAGE // manage organizational units (incl. faculty/department mirror)
  PEOPLE_MANAGE // manage institutional people records
  APPOINTMENTS_MANAGE // manage position appointments
  COUNCILS_MANAGE // manage councils/meetings/minutes/resolutions
  PROGRAMS_MANAGE // manage programs/versions/enrollments/terms
  CREDENTIALS_MANAGE // award/revoke formal credentials
  ACCREDITATION_MANAGE // record external accreditation/licenses/inspections/findings
  QUALITY_INTERNAL_MANAGE // internal QA-office self-assessment writes (explicit grant only)
  FACILITIES_MANAGE // manage facilities/equipment/work orders/reservations
  RESEARCH_PROJECTS_MANAGE // manage institutional research projects
  UNIT_CAPABILITIES_ASSIGN // grant/revoke unit-scoped capability grants (r352 hardening)
}

