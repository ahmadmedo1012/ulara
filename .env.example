# ──────────────────────────────────────────────────────────────────────
# ULARA — backend environment template.
#
# Copy to backend/.env and fill in the REQUIRED values:
#
#   cp .env.example backend/.env
#
# (README Quickstart + CONTRIBUTING. NEVER commit .env or real secrets —
#  this template ships placeholders only, by design. The authoritative
#  validation is backend/src/env.ts: only DATABASE_URL + the two JWT
#  secrets are required; everything else has a sane default and fails
#  CLOSED at boot when half-configured.)
# ──────────────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────────────
# PostgreSQL (Neon/Render/local). Prisma: backend/prisma/schema.prisma.
DATABASE_URL=postgresql://user:password@localhost:5432/ulara

# Session signing keys — each ≥32 chars, and the two MUST differ
# (backend/src/index.ts refuses boot when equal).
JWT_ACCESS_SECRET=change-me-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-at-least-32-characters-long

# ── Optional — server ─────────────────────────────────────────────────
# NODE_ENV=development            # development | production | test
# PORT=4000
# CORS_ORIGINS=https://ulara.vercel.app,http://localhost:5173
# INTERNAL_SERVICE_TOKEN=         # service-to-service token (≥16 chars)
# GIT_SHA=                        # deployment identity (auto on Vercel/Render)

# ── Optional — file storage (uploads: backend/src/lib/storage.ts) ─────
# STORAGE_DRIVER=local            # local | s3 | postgres (postgres = BYTEA rows)
# STORAGE_DIR=                    # absolute override for the local driver root
# S3_ENDPOINT=                    # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Optional — transactional mail (backend/src/lib/mail.ts) ───────────
# MAIL_PROVIDER=none              # none | resend | brevo
# MAIL_API_KEY=
# MAIL_FROM=
# APP_ORIGIN=                     # app origin for email footer links

# ── Optional — AI provider (chat assistant: backend/src/lib/ai.ts) ────
# Default 'local' composes replies in-process (zero cost, zero calls).
# AI_PROVIDER=local               # local | openai
# AI_BASE_URL=                    # OpenAI-compatible, keep the /v1 suffix
# AI_API_KEY=
# AI_MODEL=
# AI_MODELS=                      # ordered ≤3 free-model ids (OpenRouter)
# AI_TIMEOUT_MS=45000             # one provider round-trip ceiling (5s..90s)
# AI_DAILY_LIMIT_DEFAULT=25       # daily asks per user (1..1000)

# ── Optional — speech-to-text (r323 B2.3) ─────────────────────────────
# STT_API_URL=                    # OpenAI-compatible /audio/transcriptions
# STT_API_KEY=
# STT_MODEL=

# ── Optional — mobile gate + push (r326) ──────────────────────────────
# MIN_APP_VERSION=                # semver — unset keeps a bare clone permissive
# APP_DOWNLOAD_URL=               # defaults to the deployed /app page
# PUSH_ENABLED=false              # Expo push send path (FCM/APNs configured)
